{
  "_meta": {
    "file": "manifest.json",
    "version": "1.4.0",
    "description": "Манифест PWA: maskable PNG, shortcuts, screenshots."
  },
  "id": "/GymPlan/",
  "name": "GymPlan - Трекер тренировок",
  "short_name": "GymPlan",
  "description": "Дневник тренировок с офлайн-режимом",
  "start_url": "/GymPlan/",
  "scope": "/GymPlan/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#09090B",
  "theme_color": "#09090B",
  "lang": "ru",
  "dir": "ltr",
  "categories": ["health", "fitness", "sports"],
  "icons": [
    {
      "src": "/GymPlan/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/GymPlan/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/GymPlan/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/GymPlan/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/GymPlan/icon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Библиотека",
      "short_name": "Библиотека",
      "url": "/GymPlan/?screen=library",
      "icons": [{ "src": "/GymPlan/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "История",
      "short_name": "История",
      "url": "/GymPlan/?screen=history",
      "icons": [{ "src": "/GymPlan/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "/GymPlan/screenshot-1.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow"
    }
  ]
}
